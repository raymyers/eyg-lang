   "expected": {"0":"f","l":"$","b":{"0":"l","l":"a","v":{"0":"a","f":{"0":"g","l":"x"},"a":{"0":"v","l":"$"}},"t":{"0":"l","l":"b","v":{"0":"a","f":{"0":"g","l":"y"},"a":{"0":"v","l":"$"}},"t":{"0":"i","v":5}}}}},

  {"name": "apply", "source": "a(1)",
   "expected": {"0":"a","f":{"0":"v","l":"a"},"a":{"0":"i","v":1}}},
  {"name": "apply_chained", "source": "a(10)(20)",
   "expected": {"0":"a","f":{"0":"a","f":{"0":"v","l":"a"},"a":{"0":"i","v":10}},"a":{"0":"i","v":20}}},
  {"name": "apply_nested", "source": "x(y(3))",
   "expected": {"0":"a","f":{"0":"v","l":"x"},"a":{"0":"a","f":{"0":"v","l":"y"},"a":{"0":"i","v":3}}}},
  {"name": "apply_multi_arg", "source": "a(x, y)",
   "expected": {"0":"a","f":{"0":"a","f":{"0":"v","l":"a"},"a":{"0":"v","l":"x"}},"a":{"0":"v","l":"y"}}},

  {"name": "let_simple", "source": "let x = 5\n   x",
   "expected": {"0":"l","l":"x","v":{"0":"i","v":5},"t":{"0":"v","l":"x"}}},
  {"name": "let_field_access", "source": "let x = 5\n   x.foo",
   "expected": {"0":"l","l":"x","v":{"0":"i","v":5},"t":{"0":"a","f":{"0":"g","l":"foo"},"a":{"0":"v","l":"x"}}}},
  {"name": "let_nested_value", "source": "let x =\n    let y = 3\n    y\n   x",
   "expected": {"0":"l","l":"x","v":{"0":"l","l":"y","v":{"0":"i","v":3},"t":{"0":"v","l":"y"}},"t":{"0":"v","l":"x"}}},
  {"name": "let_sequential", "source": "let x = 5\n   let y = 1\n   x",
   "expected": {"0":"l","l":"x","v":{"0":"i","v":5},"t":{"0":"l","l":"y","v":{"0":"i","v":1},"t":{"0":"v","l":"x"}}}},

  {"name": "let_destructure", "source": "let {x: a, y: _} = rec\n   a",
   "expected": {"0":"l","l":"$","v":{"0":"v","l":"rec"},"t":{"0":"l","l":"a","v":{"0":"a","f":{"0":"g","l":"x"},"a":{"0":"v","l":"$"}},"t":{"0":"l","l":"_","v":{"0":"a","f":{"0":"g","l":"y"},"a":{"0":"v","l":"$"}},"t":{"0":"v","l":"a"}}}}},
  {"name": "let_destructure_shorthand", "source": "let {x, y} = rec\n   a",
   "expected": {"0":"l","l":"$","v":{"0":"v","l":"rec"},"t":{"0":"l","l":"x","v":{"0":"a","f":{"0":"g","l":"x"},"a":{"0":"v","l":"$"}},"t":{"0":"l","l":"y","v":{"0":"a","f":{"0":"g","l":"y"},"a":{"0":"v","l":"$"}},"t":{"0":"v","l":"a"}}}}},
  {"name": "let_destructure_empty", "source": "let {} = rec\n   a",
   "expected": {"0":"l","l":"$","v":{"0":"v","l":"rec"},"t":{"0":"v","l":"a"}}},

  {"name": "list_empty", "source": "[]", "expected": {"0":"ta"}},
  {"name": "list_elements", "source": "[1, 2]",
