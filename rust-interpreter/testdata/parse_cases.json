   "expected": {"0":"a","f":{"0":"a","f":{"0":"c"},"a":{"0":"i","v":1}},"a":{"0":"a","f":{"0":"v","l":"x"},"a":{"0":"i","v":5}}}},

  {"name": "record_empty", "source": "{}", "expected": {"0":"u"}},
  {"name": "record_fields", "source": "{a: 5, b: {}}",
