[
  {"name": "variable", "source": "x", "expected": {"0":"v","l":"x"}},
  {"name": "integer", "source": "12", "expected": {"0":"i","v":12}},
  {"name": "string", "source": "\"hello\"", "expected": {"0":"s","v":"hello"}},
  {"name": "string_escape", "source": "\"\\\"\"", "expected": {"0":"s","v":"\""}},
  {"name": "negative_integer", "source": "-100", "expected": {"0":"i","v":-100}},

  {"name": "lambda_single", "source": "(x) -> { 5 }",
   "expected": {"0":"f","l":"x","b":{"0":"i","v":5}}},
  {"name": "lambda_multi", "source": "(x, y) -> { 5 }",
   "expected": {"0":"f","l":"x","b":{"0":"f","l":"y","b":{"0":"i","v":5}}}},
