  {"name": "record_complex_value", "source": "{foo: x(2)}",
   "expected": {"0":"a","f":{"0":"a","f":{"0":"e","l":"foo"},"a":{"0":"a","f":{"0":"v","l":"x"},"a":{"0":"i","v":2}}},"a":{"0":"u"}}},
  {"name": "record_shorthand", "source": "{a, b}",
