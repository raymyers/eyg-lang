  {"name": "identity_spread", "source": "{..x}", "expected": {"0":"v","l":"x"}},
  {"name": "overwrite_shorthand", "source": "{a, ..x}",
   "expected": {"0":"a","f":{"0":"a","f":{"0":"o","l":"a"},"a":{"0":"v","l":"a"}},"a":{"0":"v","l":"x"}}},

  {"name": "field_access", "source": "a.foo",
   "expected": {"0":"a","f":{"0":"g","l":"foo"},"a":{"0":"v","l":"a"}}},
  {"name": "field_access_call", "source": "b(x).foo",
   "expected": {"0":"a","f":{"0":"g","l":"foo"},"a":{"0":"a","f":{"0":"v","l":"b"},"a":{"0":"v","l":"x"}}}},
