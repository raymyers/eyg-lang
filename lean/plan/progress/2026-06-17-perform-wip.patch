+              · exact absurd (Ty.tyEquiv_effContains_mp he hmemTail)
+                  (fun ⟨_, _, hcc, _, _⟩ => effContains_empty hcc)
+            have hacc' : StackSegWf ((Kontinue.Delimit l h e_ false, mt) :: acc).reverse b'' εtop
